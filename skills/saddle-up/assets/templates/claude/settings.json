{
  "_comment": "Template: project .claude/settings.json for a saddled repo. Fill the allow list from the repo's MEASURED commands (discovery), keep denials, review with the human before committing (design-and-install rule 10 — trust config installs only on approval).",
  "permissions": {
    "allow": [
      "Bash(./scripts/verify*)",
      "Bash(./init.sh*)",
      "Bash({{TEST_CMD}}*)",
      "Bash({{LINT_CMD}}*)",
      "Bash({{TYPECHECK_CMD}}*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(npm publish*)",
      "Bash(git reset --hard*)",
      "Read(.env*)",
      "Read(**/secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-saddle.sh"
          }
        ]
      }
    ]
  }
}
